# Docs overlay env — use with docker-compose.docs.yml:
#   docker compose -f docker-compose.self-host.yml -f docker-compose.docs.yml \
#     --env-file .env.self-host --env-file .env.docs up -d

GREENLIGHT_DOCS_IMAGE=ghcr.io/markokosticdev/greenlight-docs:latest

# Public docs URL (no trailing slash)
NEXT_PUBLIC_DOCS_URL=https://docs.example.com
