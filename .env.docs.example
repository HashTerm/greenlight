# ─── GHCR image (docker-compose.docs.yml) ─────────────────────────────────────
#   docker compose -f docker-compose.docs.yml --env-file .env.docs up -d

GREENLIGHT_DOCS_IMAGE=ghcr.io/markokosticdev/greenlight-docs:latest

# Public docs URL (no trailing slash)
NEXT_PUBLIC_DOCS_URL=https://docs.example.com

# ─── Standalone build (docker-compose.docs.build.yml) ─────────────────────────
#   docker compose -f docker-compose.docs.build.yml --env-file .env.docs up -d --build
#
# NEXT_PUBLIC_DOCS_URL only — no GREENLIGHT_DOCS_IMAGE needed when building on server.
#
# ─── Standalone Swarm (docker-compose.docs.stack.yml) ─────────────────────────
#   stack deploy -c docker-compose.docs.stack.yml greenlight-docs --with-registry-auth
