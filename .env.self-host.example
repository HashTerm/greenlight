# Paste into Dokploy or Coolify Environment tab (Compose app), or use as --env-file.
# DATABASE_URL is built automatically from POSTGRES_* vars in docker-compose.self-host.yml.
# Register platform channels via API after deploy — no bot tokens in env.

# ─── Images (GHCR — override to pin a version tag) ───────────────────────────

GREENLIGHT_IMAGE=ghcr.io/markokosticdev/greenlight:latest
GREENLIGHT_UI_IMAGE=ghcr.io/markokosticdev/greenlight-ui:latest

# ─── Postgres (bundled) ────────────────────────────────────────────────────────

POSTGRES_USER=greenlight
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=greenlight

# ─── Webhooks ────────────────────────────────────────────────────────────────

# Set when domain is assigned in Dokploy/Coolify, e.g. https://greenlight.example.com
# Webhooks: {PUBLIC_WEBHOOK_URL}/webhooks/{organization_id}/{platform}/{channel_id}
PUBLIC_WEBHOOK_URL=
WEBHOOK_SECRET=replace-with-a-strong-random-string

# Optional default prompt channel (must be registered via API first)
# DEFAULT_PROMPT_CHANNEL_ID=my-telegram-prompts

# ─── Security ────────────────────────────────────────────────────────────────

CALLBACK_SIGNING_SECRET=replace-with-a-strong-random-string
USE_AUTH=false
GREENLIGHT_API_KEY=
AUTH_SECRET=replace-with-authjs-secret
AUTH_URL=
AUTH_TRUST_HOST=true

# ─── App ─────────────────────────────────────────────────────────────────────

PORT=8100
CLEAN_ON_BOOT=true
ENABLE_DOCS=false

# ─── Channel Gateway ─────────────────────────────────────────────────────────

CHANNEL_CALLBACK_MAX_RETRIES=3
CHANNEL_CALLBACK_RETRY_DELAY=5
CHANNEL_OFFLINE_NOTIFICATION=Assistant offline, could not deliver message.

# ─── Enterprise edition (optional) ───────────────────────────────────────────
# Signed JWT from Greenlight licensing — verified locally in the injected image.
# Production images only trust production-signed JWTs (not dev keys).
# GREENLIGHT_LICENSE=
# GREENLIGHT_LICENSE_FILE=/etc/greenlight/license.jwt
# Require JWT sub to match your customer id (optional)
# GREENLIGHT_LICENSE_CUSTOMER_ID=
# Fail startup when license env/file is set but invalid (optional)
# GREENLIGHT_LICENSE_STRICT=true
# Local inject testing with dev-signed JWTs only:
# GREENLIGHT_DEV=true
# Optional online refresh (dev); production uses licensing.ongreenlight.com
# LICENSING_URL=
