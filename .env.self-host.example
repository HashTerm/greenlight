# Paste into Dokploy Environment tab (Compose app), or use as --env-file.
# DATABASE_URL is built automatically from POSTGRES_* vars in docker-compose.self-host.yml.
# Register platform channels via API after deploy — no bot tokens in env.
# ADMIN_INTERNAL_TOKEN is for the UI stack only — do not distribute to agent integrators.

# ─── Images (GHCR — override to pin a version tag) ───────────────────────────

GREENLIGHT_IMAGE=ghcr.io/markokosticdev/greenlight:latest
GREENLIGHT_UI_IMAGE=ghcr.io/markokosticdev/greenlight-ui:latest

# ─── Postgres (bundled) ────────────────────────────────────────────────────────

POSTGRES_USER=greenlight
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=greenlight

# ─── Webhooks ────────────────────────────────────────────────────────────────

# Set when domain is assigned in Dokploy, e.g. https://greenlight.services.hashterm.com
PUBLIC_WEBHOOK_URL=
WEBHOOK_SECRET=replace-with-a-strong-random-string

# Optional default prompt channel (must be registered via API first)
# DEFAULT_PROMPT_CHANNEL_ID=my-telegram-prompts

# ─── Security ────────────────────────────────────────────────────────────────

CALLBACK_SIGNING_SECRET=replace-with-a-strong-random-string
USE_AUTH=false
API_KEY=
ADMIN_INTERNAL_TOKEN=replace-with-a-strong-internal-token
AUTH_SECRET=replace-with-authjs-secret
AUTH_URL=
AUTH_TRUST_HOST=true

# ─── App ─────────────────────────────────────────────────────────────────────

PORT=8100
CLEAN_ON_BOOT=true
ENABLE_DOCS=false

# ─── Channel Gateway ─────────────────────────────────────────────────────────

CHANNEL_CALLBACK_MAX_RETRIES=3
CHANNEL_CALLBACK_RETRY_DELAY=5
CHANNEL_OFFLINE_NOTIFICATION=Assistant offline, could not deliver message.
