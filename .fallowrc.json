{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "core/src/index.ts",
    "ui/app/**/page.tsx",
    "ui/app/**/layout.tsx",
    "ui/app/**/route.ts",
    "ui/proxy.ts",
    "docs-site/app/**/page.tsx",
    "docs-site/app/**/layout.tsx",
    "docs-site/mdx-components.tsx",
    "docs-site/content/**/*.{mdx,ts,tsx}",
    "docs-site/lib/**/*.{js,mjs,ts,tsx}",
    "scripts/**/*.{js,mjs}"
  ],
  "ignorePatterns": [
    "**/.next/**",
    "**/dist/**",
    "**/*.d.ts",
    "**/node_modules/**",
    "docs-site/public/openapi.json"
  ],
  "ignoreDependencies": [
    "nextra-theme-docs-layout-internals",
    "eslint-config-next"
  ],
  "workspaces": {
    "patterns": ["core", "ui", "docs-site"]
  },
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "warn",
    "unused-enum-members": "warn",
    "unused-class-members": "warn",
    "duplicate-exports": "warn",
    "circular-dependencies": "warn"
  },
  "health": {
    "maxCyclomatic": 40,
    "maxCognitive": 40,
    "maxCrap": 500,
    "maxUnitSize": 200
  }
}
