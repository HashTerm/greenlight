# No per-platform bot tokens here — register channels via API after startup
#
# Hybrid npm dev uses localhost below. Full Docker (--profile full) overrides
# DATABASE_URL inside compose to use the postgres service hostname.

# ─── Database ────────────────────────────────────────────────────────────────

# Host-side URL for npm run dev / db:migrate (Postgres via docker compose)
DATABASE_URL=postgresql://greenlight:greenlight@localhost:5431/greenlight
# Host port mapped to the Postgres container (community UI :3001 → Postgres :5431)
POSTGRES_PORT=5431

# ─── Webhooks ────────────────────────────────────────────────────────────────

# Public base URL (no trailing slash). Platform webhooks:
#   {PUBLIC_WEBHOOK_URL}/webhooks/{organization_id}/{platform}/{channel_id}
# Self-host uses organization_id=default. Local Telegram polling: http://localhost:8100 is enough
PUBLIC_WEBHOOK_URL=http://localhost:8100
WEBHOOK_SECRET=replace-with-a-strong-random-string

# Optional default channel for prompts when channel_id is omitted
# DEFAULT_PROMPT_CHANNEL_ID=my-telegram-prompts

# ─── Security ────────────────────────────────────────────────────────────────

CALLBACK_SIGNING_SECRET=replace-with-a-strong-random-string
USE_AUTH=true
AUTH_SECRET=replace-with-authjs-secret

# ─── API key (core bootstrap + Admin UI) ─────────────────────────────────────
# Seeds the first admin key when api_keys is empty; UI sends this as X-API-Key.
# After creating a new key in Settings, update this value and restart the UI.

GREENLIGHT_API_URL=http://localhost:8100
GREENLIGHT_API_KEY=replace-with-a-strong-random-api-key

# ─── Enterprise edition (optional) ───────────────────────────────────────────
# Community edition works without these. Set a signed JWT from your license,
# or mount GREENLIGHT_LICENSE_FILE=/etc/greenlight/license.jwt
GREENLIGHT_LICENSE=
GREENLIGHT_LICENSE_FILE=
GREENLIGHT_LICENSE_CUSTOMER_ID=
GREENLIGHT_LICENSE_STRICT=
LICENSING_URL=

# ─── Media ───────────────────────────────────────────────────────────────────

# MEDIA_ALLOWED_DIR=/app/media
# MAX_MEDIA_SIZE_MB=2

# ─── Docs ────────────────────────────────────────────────────────────────────

# ENABLE_DOCS=false

# ─── Boot ────────────────────────────────────────────────────────────────────

CLEAN_ON_BOOT=true

# ─── Channel Gateway ─────────────────────────────────────────────────────────

CHANNEL_CALLBACK_MAX_RETRIES=3
CHANNEL_CALLBACK_RETRY_DELAY=5
CHANNEL_OFFLINE_NOTIFICATION=Assistant offline, could not deliver message.
# Reply when user presses Start in a private Telegram PROMPT chat (empty disables)
TELEGRAM_CHANNEL_START_REPLY=Greenlight is connected. You'll receive prompts here.

# ─── Server ──────────────────────────────────────────────────────────────────

PORT=8100
HOST=0.0.0.0
